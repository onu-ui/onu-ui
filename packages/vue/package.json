{
  "name": "onu-ui",
  "type": "module",
  "version": "1.1.5",
  "description": "Onu UI Vue Components",
  "author": "Chris <https://github.com/zyyv>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onu-ui/onu-ui.git",
    "directory": "packages/vue"
  },
  "bugs": {
    "url": "https://github.com/onu-ui/onu-ui/issues"
  },
  "keywords": [
    "Onu UI",
    "UnoCSS",
    "vue",
    "ui library"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/onu-ui.js",
      "require": "./dist/onu-ui.umd.cjs"
    },
    "./style.css": "./dist/onu-ui.css",
    "./dist/onu-ui.css": "./dist/onu-ui.css"
  },
  "main": "./dist/onu-ui.umd.cjs",
  "module": "./dist/onu-ui.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite build -w & pnpm uno-watch",
    "build": "vite build && pnpm uno",
    "uno": "unocss -m",
    "uno-watch": "unocss -w"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@onu-ui/preset": "workspace:*",
    "@vueuse/core": "catalog:vue"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "catalog:vue",
    "unocss": "catalog:unocss",
    "vite": "catalog:build",
    "vue": "catalog:vue"
  },
  "publishConfig": {
    "access": "public"
  }
}
